# EvidenceRoute environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored and MUST NOT be
# committed. Every value below is a placeholder — no real endpoint, deployment
# name, key or tenant identifier belongs in this file.
#
#   cp .env.example .env
#
# All settings are read through `evidence_route.config.Settings`, which loads
# `.env` at runtime. Nothing in `src/` hardcodes a provider endpoint.
# ---------------------------------------------------------------------------

# --- Generation provider: Azure OpenAI --------------------------------------
# Base endpoint of the Azure OpenAI resource, e.g. https://<resource>.openai.azure.com/
EVIDENCE_ROUTE_AZURE_OPENAI_ENDPOINT=
EVIDENCE_ROUTE_AZURE_OPENAI_API_KEY=
EVIDENCE_ROUTE_AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (NOT model names) configured in the Azure resource.
# Primary generation model for the frozen benchmark runs.
EVIDENCE_ROUTE_AZURE_OPENAI_CHAT_DEPLOYMENT=
# Cheaper deployment used for pipeline debugging (spec section 26, item 6).
EVIDENCE_ROUTE_AZURE_OPENAI_CHEAP_CHAT_DEPLOYMENT=
# Embedding deployment for the dense retrieval action (A2).
EVIDENCE_ROUTE_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Judge deployment. Prefer a different model family from the generator so the
# judge does not grade its own outputs (spec section 27, judge-bias risk).
EVIDENCE_ROUTE_AZURE_OPENAI_JUDGE_DEPLOYMENT=

# --- Optional: Entra ID / managed identity instead of an API key ------------
# Leave the API key blank and set these to use AAD token auth.
EVIDENCE_ROUTE_AZURE_USE_ENTRA_ID=false
EVIDENCE_ROUTE_AZURE_TENANT_ID=
EVIDENCE_ROUTE_AZURE_CLIENT_ID=
EVIDENCE_ROUTE_AZURE_CLIENT_SECRET=

# --- Local embedding / reranking alternatives -------------------------------
# Used when Azure embeddings are unavailable or for the offline smoke path.
EVIDENCE_ROUTE_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EVIDENCE_ROUTE_LOCAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Cost control (spec section 26) -----------------------------------------
# Hard ceiling in USD for a single experiment run. Runs abort before exceeding.
EVIDENCE_ROUTE_MAX_EXPERIMENT_BUDGET_USD=25.0
# Cache LLM and retrieval responses so unchanged actions are never re-billed.
EVIDENCE_ROUTE_ENABLE_RESPONSE_CACHE=true

# --- SEC EDGAR --------------------------------------------------------------
# Required to fetch the FinanceBench document corpus. The SEC mandates a
# User-Agent identifying you and including contact information, and returns 403
# without one. Put your real name and email here.
# See https://www.sec.gov/os/webmaster-faq#developers
EVIDENCE_ROUTE_SEC_USER_AGENT=

# --- Paths ------------------------------------------------------------------
EVIDENCE_ROUTE_DATA_DIR=./data
EVIDENCE_ROUTE_CACHE_DIR=./.cache
EVIDENCE_ROUTE_RUNS_DIR=./experiments/runs

# --- Reproducibility --------------------------------------------------------
EVIDENCE_ROUTE_RANDOM_SEED=20260815
# When true, any run touching the frozen test split is refused unless the
# protocol is explicitly unlocked. Guards against final-test-driven tuning.
EVIDENCE_ROUTE_PROTECT_TEST_SPLIT=true

# --- Logging ----------------------------------------------------------------
EVIDENCE_ROUTE_LOG_LEVEL=INFO

# --- Offline mode -----------------------------------------------------------
# When true, no network or paid API calls are made; fixtures are used instead.
# The CI smoke experiment runs with this enabled.
EVIDENCE_ROUTE_OFFLINE=false
