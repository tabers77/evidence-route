# Normalise line endings so a Windows checkout does not produce artifacts that
# break on Linux.

* text=auto

# MUST be LF. A shell script checked out with CRLF fails in the container with
# a misleading "no such file or directory" — the shebang line ends up carrying
# a trailing \r, so the kernel looks for an interpreter that does not exist.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Same reasoning: these are read by Linux tooling regardless of where they were
# authored.
Dockerfile text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell is Windows-side; keep it CRLF.
*.ps1 text eol=crlf

# Binary formats — never diff or normalise these.
*.parquet binary
*.faiss binary
*.index binary
*.bin binary
*.pdf binary
*.png binary
*.jpg binary
*.zip binary
*.gz binary

# Notebooks diff badly by default; mark them so tooling can special-case them.
*.ipynb text eol=lf
